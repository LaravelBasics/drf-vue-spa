# views.py
import json
import logging
from datetime import datetime
from django.http import JsonResponse
from django.views import View
from django.views.decorators.csrf import csrf_exempt
from django.utils.decorators import method_decorator
from .models import LegacyUser, LegacyUserGroup
import hashlib

# 監査ログ専用ロガー
audit_logger = logging.getLogger('audit')

def get_client_ip(request):
    """IPアドレス取得"""
    x_forwarded_for = request.META.get('HTTP_X_FORWARDED_FOR')
    if x_forwarded_for:
        ip = x_forwarded_for.split(',')[0]
    else:
        ip = request.META.get('REMOTE_ADDR')
    return ip

def write_audit_log(action, user_id=None, group_id=None, request=None, extra=None):
    """監査ログ書き込み共通関数"""
    log_entry = {
        'timestamp': datetime.now().isoformat(),
        'action': action,
        'user_id': user_id,
        'group_id': group_id,
    }
    
    if request:
        log_entry['ip_address'] = get_client_ip(request)
        log_entry['user_agent'] = request.META.get('HTTP_USER_AGENT', '')
    
    if extra:
        log_entry.update(extra)
    
    # ログレベル分け
    if 'FAILED' in action or 'ERROR' in action:
        audit_logger.warning(json.dumps(log_entry, ensure_ascii=False))
    else:
        audit_logger.info(json.dumps(log_entry, ensure_ascii=False))

@method_decorator(csrf_exempt, name='dispatch')
class LoginView(View):
    """ログインビュー"""
    
    def post(self, request):
        try:
            data = json.loads(request.body)
            user_id = data.get('user_id')
            password = data.get('password')
            group_id = data.get('group_id')
            
            # バリデーション
            if not all([user_id, password, group_id]):
                write_audit_log('LOGIN_FAILED', user_id, group_id, request, 
                               {'reason': 'missing_credentials'})
                return JsonResponse({'error': 'Missing credentials'}, status=400)
            
            # 認証処理
            try:
                user = LegacyUser.objects.get(user_id=user_id)
                
                # パスワードチェック
                password_hash = hashlib.sha256(password.encode()).hexdigest()
                if password_hash != user.password_hash:
                    write_audit_log('LOGIN_FAILED', user_id, group_id, request,
                                   {'reason': 'invalid_password'})
                    return JsonResponse({'error': 'Invalid credentials'}, status=401)
                
                # グループチェック
                if not LegacyUserGroup.objects.filter(user_id=user_id, group_id=group_id).exists():
                    write_audit_log('LOGIN_FAILED', user_id, group_id, request,
                                   {'reason': 'invalid_group'})
                    return JsonResponse({'error': 'Invalid group'}, status=401)
                
                # アクティブチェック
                if not user.is_active:
                    write_audit_log('LOGIN_FAILED', user_id, group_id, request,
                                   {'reason': 'user_inactive'})
                    return JsonResponse({'error': 'User is inactive'}, status=401)
                
                # セッション作成
                request.session['user_id'] = user_id
                request.session['group_id'] = group_id
                request.session['login_time'] = datetime.now().isoformat()
                
                # ✅ ログイン成功ログ
                write_audit_log('LOGIN_SUCCESS', user_id, group_id, request)
                
                return JsonResponse({
                    'status': 'success',
                    'user_id': user_id,
                    'group_id': group_id
                })
                
            except LegacyUser.DoesNotExist:
                write_audit_log('LOGIN_FAILED', user_id, group_id, request,
                               {'reason': 'user_not_found'})
                return JsonResponse({'error': 'Invalid credentials'}, status=401)
                
        except json.JSONDecodeError:
            write_audit_log('LOGIN_FAILED', None, None, request,
                           {'reason': 'invalid_json'})
            return JsonResponse({'error': 'Invalid JSON'}, status=400)
        except Exception as e:
            write_audit_log('LOGIN_ERROR', None, None, request,
                           {'reason': str(e)})
            return JsonResponse({'error': 'Internal error'}, status=500)

@method_decorator(csrf_exempt, name='dispatch')
class LogoutView(View):
    """ログアウトビュー"""
    
    def post(self, request):
        user_id = request.session.get('user_id')
        group_id = request.session.get('group_id')
        
        # ✅ ログアウトログ
        write_audit_log('LOGOUT', user_id, group_id, request)
        
        # セッション破棄
        request.session.flush()
        
        return JsonResponse({'status': 'success'})

# データ操作ビューの例
@method_decorator(csrf_exempt, name='dispatch')
class UserUpdateView(View):
    """ユーザー更新ビュー"""
    
    def post(self, request):
        # セッションチェック
        current_user_id = request.session.get('user_id')
        current_group_id = request.session.get('group_id')
        
        if not current_user_id:
            return JsonResponse({'error': 'Not authenticated'}, status=401)
        
        try:
            data = json.loads(request.body)
            target_user_id = data.get('target_user_id')
            new_email = data.get('email')
            
            # 更新前データ取得
            user = LegacyUser.objects.get(user_id=target_user_id)
            old_email = user.email
            
            # 更新実行
            user.email = new_email
            user.save()
            
            # ✅ データ更新ログ
            write_audit_log('USER_UPDATE', current_user_id, current_group_id, request, {
                'target_user_id': target_user_id,
                'field': 'email',
                'old_value': old_email,
                'new_value': new_email
            })
            
            return JsonResponse({'status': 'success'})
            
        except LegacyUser.DoesNotExist:
            write_audit_log('USER_UPDATE_FAILED', current_user_id, current_group_id, request, {
                'reason': 'user_not_found',
                'target_user_id': target_user_id
            })
            return JsonResponse({'error': 'User not found'}, status=404)
        except Exception as e:
            write_audit_log('USER_UPDATE_ERROR', current_user_id, current_group_id, request, {
                'reason': str(e),
                'target_user_id': target_user_id
            })
            return JsonResponse({'error': str(e)}, status=500)

# 認証チェックデコレーター
def require_auth(view_func):
    """認証必須デコレーター"""
    def wrapper(request, *args, **kwargs):
        user_id = request.session.get('user_id')
        if not user_id:
            write_audit_log('UNAUTHORIZED_ACCESS', None, None, request, {
                'path': request.path
            })
            return JsonResponse({'error': 'Not authenticated'}, status=401)
        return view_func(request, *args, **kwargs)
    return wrapper
