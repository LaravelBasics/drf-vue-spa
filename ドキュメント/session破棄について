python# accounts/views.py

class LogoutAPIView(APIView):
    """ログアウトAPI（セッション完全削除版）"""

    permission_classes = [IsAuthenticated]
    authentication_classes = [CSRFEnforcedSessionAuthentication]

    def post(self, request):
        user_info = request.user.user_id
        session_key = request.session.session_key  # ← 記録用
        
        # 監査ログ
        audit_logger.info(f"ログアウト: user={user_info}, session={session_key}")
        
        # ✅ セッション完全削除
        request.session.flush()  # DB からも削除
        
        # ✅ ログアウト実行
        logout(request)
        
        return Response({"detail": "logged_out"})
