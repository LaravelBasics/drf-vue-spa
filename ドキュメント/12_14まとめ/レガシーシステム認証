- last_login (TIMESTAMP)
- created_at (TIMESTAMP)
- updated_at (TIMESTAMP)

# Django認証システム必須設定
USERNAME_FIELD = "user_id"            # ログイン時のユーザー識別子
REQUIRED_FIELDS = []

# 認証プロパティ
is_authenticated → True（常に）
is_anonymous → False（常に）
is_admin → bool(is_superuser or is_staff)  # ★計算プロパティ★

# パスワード管理
