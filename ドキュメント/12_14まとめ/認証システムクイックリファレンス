### 5️⃣ ログアウト処理

```javascript
// stores/auth.js
async function logout(redirect = true) {
    try {
        await authAPI.logout();
    } finally {
        user.value = null;
        currentGroupId.value = null;
        resetCSRFToken();
        
        if (redirect) {
            router.push({ name: 'Login' });
        }
    }
}
```

