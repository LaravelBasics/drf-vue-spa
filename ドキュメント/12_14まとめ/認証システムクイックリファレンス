### 3️⃣ ログインAPIの呼び出し（Vue.js）

```javascript
// api/auth.js
import api from '@/plugins/axios';

export const authAPI = {
    async login(groupId, userId, password) {
        const response = await api.post('auth/login/', {
            group_id: groupId,
            user_id: userId,
            password,
        });
        return response;
    },
};

// stores/auth.js
async function loginSession(groupId, userId, password) {
    try {
        await authAPI.login(groupId, userId, password);
        await fetchUser();
        router.push('/');
    } catch (error) {
        console.error(error);
    }
}
```

