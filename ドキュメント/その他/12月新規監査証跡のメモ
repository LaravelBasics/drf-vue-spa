class EnhancedAuditJSONFormatter(logging.Formatter):
    """
    拡張版監査ログフォーマッター（Phase 2+）
    
    追加項目:
    - ユーザー詳細（名前、部署）
    - ブラウザ情報（User-Agent解析）
    - パフォーマンス情報（レスポンス時間）
    """
    
    def format(self, record):
        """ログレコードをJSON形式に変換（拡張版）"""
        log_data = {
            # ========== 基本情報 ==========
            "request_id": getattr(record, "request_id", "N/A"),
            "timestamp": self.formatTime(record, datefmt="%Y-%m-%d %H:%M:%S"),
            "level": record.levelname,
            
            # ========== Who（誰が） - 拡張 ==========
            "user": self._format_user(record),
            
            # ========== Where（どこで） - 拡張 ==========
            "location": self._format_location(record),
            
            # ========== What（何を） ==========
            "resource": self._format_resource(record),
            
            # ========== How（どのように） - 拡張 ==========
            "technical": self._format_technical(record),
            
            # ========== 変更内容 ==========
            "changes": getattr(record, "changes", "{}"),
            
            # ========== メッセージ ==========
            "message": record.getMessage(),
        }
        
        return json.dumps(log_data, ensure_ascii=False)
    
    def _format_user(self, record):
        """ユーザー情報をフォーマット"""
        user_data = getattr(record, "user_data", None)
        
        if user_data and isinstance(user_data, dict):
            return {
                "employee_id": user_data.get("employee_id", "unknown"),
                "username": user_data.get("username", ""),
                "department": user_data.get("department", ""),
                "role": user_data.get("role", ""),
            }
        
        # フォールバック: 従来形式
        return getattr(record, "user", "unknown")
    
    def _format_location(self, record):
        """アクセス元情報をフォーマット"""
        return {
            "ip_address": getattr(record, "ip", ""),
            "endpoint": getattr(record, "endpoint", ""),
            "http_method": getattr(record, "http_method", ""),
            "view_name": getattr(record, "view_name", ""),
            "user_agent": getattr(record, "user_agent", ""),
            "browser": getattr(record, "browser", ""),
            "os": getattr(record, "os", ""),
        }
    
    def _format_resource(self, record):
        """リソース情報をフォーマット"""
        return {
            "model": getattr(record, "model", ""),
            "object_id": getattr(record, "object_id", None),
            "object_repr": getattr(record, "object_repr", ""),
            "action": getattr(record, "action", ""),
            "affected_fields": getattr(record, "affected_fields", []),
        }
    
    def _format_technical(self, record):
        """技術情報をフォーマット"""
        return {
            "http_status": getattr(record, "http_status", None),
            "response_time_ms": getattr(record, "response_time_ms", None),
            "query_count": getattr(record, "query_count", None),
            "cache_hit": getattr(record, "cache_hit", None),
        }


