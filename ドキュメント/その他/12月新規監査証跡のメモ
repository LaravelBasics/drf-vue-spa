  "model": "User",
  "object_id": "EMP0001",
  "object_repr": "User EMP0001",
  
  // How（どのように）
  "http_status": 200,
  
  "changes": "{\"path\": \"/api/users/EMP0001/\", \"query_params\": {}}",
  "message": "機密情報閲覧: /api/users/EMP0001/ [ID: EMP0001]"
}
