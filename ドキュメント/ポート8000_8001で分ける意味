🔥 本番環境構成（nginx + gunicorn）
パターン1: 1つのgunicornで複数ポート（おすすめ）
Nginxをリバースプロキシとして使用し、Gunicornをアプリケーションサーバーとして使用することは一般的な構成です。Nginxが静的ファイルの配信やリクエストのロードバランシングを担当し、GunicornがPythonアプリケーションの処理を行います Django_本番環境構築①_nginxとgunicornでDjangoアプリケーションを動かす #363｜ゆーき|YM202110 +2。
nginx# /etc/nginx/sites-available/aaa.conf

# 店頭フロント（5173 → 静的配信）
server {
    listen 80;
    server_name storefront.example.com;
    
    root /var/www/aaa/frontend/storefront/dist;
    index index.html;
    
    # Vue.js SPA用（全てindex.htmlに）
    location / {
        try_files $uri $uri/ /index.html;
    }
    
    # 店頭API（/api/storefront → Django）
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# 管理フロント（5174 → 静的配信）
server {
    listen 80;
    server_name admin.example.com;
    
    root /var/www/aaa/frontend/admin/dist;
    index index.html;
    
    location / {
        try_files $uri $uri/ /index.html;
    }
    
    # 管理API（/api/admin → Django）
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# 静的ファイル（Django）
server {
    listen 80;
    server_name api.example.com;
    
    location /static/ {
        alias /var/www/aaa/backend/static/;
    }
    
    location /media/ {
        alias /var/www/aaa/backend/media/;
    }
    
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
gunicorn起動（systemd）
本番環境では、サービスを安定稼働させるために、SystemdでGunicornを自動管理（再起動・停止・監視）させます GunicornでDjangoプロジェクトをデプロイする方法【Nginx使用】 | CFXLOG +2。
ini# /etc/systemd/system/aaa-backend.service
[Unit]
Description=AAA Django Backend
After=network.target

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/var/www/aaa/backend
Environment="DJANGO_SETTINGS_MODULE=config.settings.production"
ExecStart=/var/www/aaa/venv/bin/gunicorn \
    --workers 7 \
    --bind unix:/run/gunicorn/aaa.sock \
    config.wsgi:application

Restart=always

[Install]
WantedBy=multi-user.target
```

