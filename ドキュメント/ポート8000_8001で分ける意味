3️⃣ アプリケーションレベル: Djangoミドルウェアでアクセス制御
Djangoのミドルウェアを使って、リクエストが処理される前にユーザーの認証状態や所属するグループを確認し、アクセス制御のロジックを適用します ReadthedocsCFXLOG。
python# accounts/middleware.py
"""
URLパスベースのアクセス制御ミドルウェア
"""
from django.http import HttpResponseForbidden
from django.urls import reverse
from users.models import UserGroup


class AccessControlMiddleware:
    """
    店頭・管理画面のアクセス制御
    
    /api/storefront/ → 店頭グループのみ
    /api/admin/      → 管理グループのみ
    """
    
    def __init__(self, get_response):
        self.get_response = get_response
    
    def __call__(self, request):
        # 認証不要のパス
        exempt_paths = [
            '/api/auth/login/',
            '/api/auth/groups/',
            '/api/auth/csrf/',
        ]
        
        if request.path in exempt_paths:
            return self.get_response(request)
        
        # 未認証ユーザーはブロック
        if not request.user.is_authenticated:
            return HttpResponseForbidden('認証が必要です')
        
        # ========================================
        # ★管理画面へのアクセスチェック★
        # ========================================
        if request.path.startswith('/api/admin/'):
            # 管理グループに所属しているか確認
            is_admin_user = UserGroup.objects.filter(
                user_id=request.user.user_id,
                group_id='admin',  # 管理グループID
                is_active=True
            ).exists()
            
            if not is_admin_user:
                return HttpResponseForbidden('管理者権限が必要です')
        
        # ========================================
        # ★店頭画面へのアクセスチェック★
        # ========================================
        elif request.path.startswith('/api/storefront/'):
            # 店頭グループに所属しているか確認
            is_storefront_user = UserGroup.objects.filter(
                user_id=request.user.user_id,
                group_id='storefront',  # 店頭グループID
                is_active=True
            ).exists()
            
            if not is_storefront_user:
                return HttpResponseForbidden('店頭アクセス権限が必要です')
        
        return self.get_response(request)
