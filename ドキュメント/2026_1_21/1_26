データ構造とシリアライズ設計
1. バックエンド（DRF）のシリアライザー例
python# serializers.py
from rest_framework import serializers

class UserGroupSelectSerializer(serializers.Serializer):
    """グループ階層付きユーザー選択用"""
    
    def to_representation(self, instance):
        # ログインユーザーの所属グループを取得
        user = self.context['request'].user
        user_groups = UserGroup.objects.filter(user_id=user.user_id)
        
        result = []
        for group in Group.objects.all():
            # グループに所属するユーザー一覧
            group_users = UserGroup.objects.filter(
                group_code=group.group_code
            ).select_related('user_id')
            
            # グループヘッダー
            group_data = {
                'type': 'group',  # グループヘッダー識別用
                'value': None,     # 選択不可
                'label': group.group_name,
                'disabled': True
            }
            result.append(group_data)
            
            # グループ配下のユーザー
            for ug in group_users:
                user_data = {
                    'type': 'user',
                    'value': ug.user_id.user_id,  # 実際の値
                    'label': f"  {ug.user_id.user_name}",  # 先頭スペース
                    'disabled': False,
                    'group_code': group.group_code  # フィルタ用
                }
                result.append(user_data)
        
        return result
