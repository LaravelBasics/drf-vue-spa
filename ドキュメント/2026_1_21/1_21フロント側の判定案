    category: 'B',
    level: authStore.permissions.B || 0
  },
  { 
    name: '受注管理', 
    icon: 'mdi-cart', 
    route: '/orders',
    category: 'C',
    level: authStore.permissions.C || 0
  },
  // ... 11個
  { 
    name: 'グループ管理', 
    icon: 'mdi-account-multiple', 
    route: '/groups',
    category: 'G',
    level: authStore.permissions.G || 0
  },
])

// 権限1以上のモジュールだけ表示
const visibleModules = computed(() => {
  return modules.value.filter(m => m.level >= 1)
})
