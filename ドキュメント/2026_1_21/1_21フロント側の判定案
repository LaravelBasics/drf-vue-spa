3. Composable（権限判定ロジック）
javascript
// composables/usePermission.js
import { computed } from 'vue'
import { useAuthStore } from '@/stores/auth'

export const usePermission = (category) => {
  const authStore = useAuthStore()
  
  const level = computed(() => authStore.permissions[category] || 0)
  
  const canView = computed(() => level.value >= 1)   // 1以上
  const canUpdate = computed(() => level.value === 2) // 2のみ
  
  return { level, canView, canUpdate }
}
