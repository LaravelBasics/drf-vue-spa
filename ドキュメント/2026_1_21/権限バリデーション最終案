# constants.py
VALID_CATEGORIES = {'A', 'B', 'C', 'D', 'E', 'F', 'G', 'H', 'I', 'J', 'K'}


# services/permission_service.py
from django.db import transaction
from ..models import PermissionMaster, GroupPermission

class PermissionService:
    
    LEVEL_MAP = {0: 'NONE', 1: 'READ', 2: 'UPDATE'}
    
    @staticmethod
    def to_permission_code(category, level):
        """整形（ここでレベル値もチェックされる）"""
        try:
            level_name = PermissionService.LEVEL_MAP[level]
        except KeyError:
            raise ValueError(f"無効なレベル: {level}（有効値: 0, 1, 2）")
        
        return f"{category}_{level_name}_{level}"
    
    @staticmethod
    def validate_permission_exists(category, level):
        """整形 + DB存在チェック"""
        permission_code = PermissionService.to_permission_code(category, level)
        
        if not PermissionMaster.objects.filter(code=permission_code).exists():
            raise ValueError(f"権限 '{permission_code}' が存在しません")
        
        return permission_code
    
    @staticmethod
    @transaction.atomic
    def update_group_permissions(group_id, permissions_data):
        """権限更新"""
        GroupPermission.objects.filter(group_id=group_id).delete()
        
        permissions = []
        for perm in permissions_data:
            permission_code = PermissionService.to_permission_code(
                perm['category'],
                perm['level']
            )
            permissions.append(GroupPermission(
                group_id=group_id,
                permission_code=permission_code
            ))
        
        GroupPermission.objects.bulk_create(permissions)
        return len(permissions)


# serializers.py
from .constants import VALID_CATEGORIES
from .services.permission_service import PermissionService

class GroupPermissionUpdateSerializer(serializers.Serializer):
    permissions = serializers.ListField(child=serializers.DictField())
    
    def validate_permissions(self, value):
        """2つのチェックのみ"""
        
        request_categories = {perm.get('category') for perm in value}
        
        # ① 差集合チェック
        missing = VALID_CATEGORIES - request_categories
        if missing:
            raise serializers.ValidationError(
                f"不足しているカテゴリ: {sorted(missing)}"
            )
        
        extra = request_categories - VALID_CATEGORIES
        if extra:
            raise serializers.ValidationError(
                f"無効なカテゴリ: {sorted(extra)}"
            )
        
        # ② DB存在チェック（0, 1, 2以外も弾かれる）
        for perm in value:
            try:
                PermissionService.validate_permission_exists(
                    perm['category'],
                    perm['level']
                )
            except ValueError as e:
                raise serializers.ValidationError(str(e))
        
        return value


# views.py
@action(detail=True, methods=['put'])
def permissions(self, request, pk=None):
    group = self.get_object()
    
    serializer = GroupPermissionUpdateSerializer(data=request.data)
    serializer.is_valid(raise_exception=True)
    
    updated_count = PermissionService.update_group_permissions(
        group.id,
        serializer.validated_data['permissions']
    )
    
    return Response({'status': 'updated', 'updated_count': updated_count})
