javascript
// composables/useGroupedSelect.js
export function useGroupedSelect() {
    const renderGroupedItem = (props, item) => {
        if (item.raw.type === 'group') {
            return { component: 'v-list-subheader', props: { class: 'font-weight-bold' } };
        }
        if (item.raw.type === 'child') {
            return { component: 'v-list-item', props: { ...props, class: 'pl-8' } };
        }
        return { component: 'v-list-item', props };
    };
    
    return { renderGroupedItem };
}
