# decorators/permission_decorators.py
from functools import wraps
from rest_framework.response import Response
from rest_framework import status

def require_permission(category, level=1):
    """
    権限チェックデコレーター
    
    使い方:
    @require_permission('A', 2)
    def my_view(request):
        ...
    """
    def decorator(view_func):
        @wraps(view_func)
        def wrapper(request, *args, **kwargs):
            # セッションから権限取得
            user_permissions = request.session.get('permissions', {})
            user_level = user_permissions.get(category, 0)
            
            # 権限チェック
            if user_level < level:
                return Response({
                    'error': f'権限がありません（必要: {category} レベル{level}）'
                }, status=status.HTTP_403_FORBIDDEN)
            
            return view_func(request, *args, **kwargs)
        
        return wrapper
    return decorator


