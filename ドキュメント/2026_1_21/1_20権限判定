# middleware/permission_middleware.py
import re
from django.http import JsonResponse
from django.conf import settings

class PermissionMiddleware:
    """URLベースの権限チェック"""
    
    def __init__(self, get_response):
        self.get_response = get_response
    
    def __call__(self, request):
        # ログインしてない場合はスキップ
        if not request.user.is_authenticated:
            return self.get_response(request)
        
        # 権限チェックが必要なパスか判定
        permission_required = self._get_required_permission(request.path)
        
        if permission_required:
            category, required_level = permission_required
            
            # セッションから権限取得
            user_permissions = request.session.get('permissions', {})
            user_level = user_permissions.get(category, 0)
            
            # 権限チェック
            if user_level < required_level:
                return JsonResponse({
                    'error': f'{self._get_category_name(category)}の権限がありません',
                    'required_permission': category,
                    'required_level': required_level,
                    'user_level': user_level
                }, status=403)
        
        return self.get_response(request)
    
    def _get_required_permission(self, path):
        """URLから必要な権限を取得"""
        # 正規表現でマッチング
        for pattern, category, level in settings.PERMISSION_RULES:
            if re.match(pattern, path):
                return (category, level)
        
        return None
    
    def _get_category_name(self, category):
        """カテゴリコードを日本語名に変換"""
        names = {
            'A': '顧客管理',
            'B': '商品管理',
            'C': '受注管理',
            # ...
        }
        return names.get(category, category)


# settings.py に追加
