# permissions/permission_classes.py
class ActionBasedPermission(permissions.BasePermission):
    """アクションごとに権限を指定"""
    
    def has_permission(self, request, view):
        # ビューのアクション権限設定を取得
        action_permissions = getattr(view, 'action_permissions', {})
        action = view.action
        
        # アクションに対応する権限設定
        perm_config = action_permissions.get(action)
        
        if not perm_config:
            return True
        
        category, required_level = perm_config
        
        # セッションから権限取得
        user_permissions = request.session.get('permissions', {})
        user_level = user_permissions.get(category, 0)
        
        return user_level >= required_level


