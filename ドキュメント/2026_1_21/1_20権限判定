# 2. パーミッションクラスで詳細チェック
# ============================================
# permissions/permission_classes.py
class HasPermission(permissions.BasePermission):
    """アクションレベルの詳細チェック"""
    
    def has_permission(self, request, view):
        category = getattr(view, 'permission_category', None)
        
        # GETは1、POST/PUT/DELETEは2
        required_level = 1 if request.method == 'GET' else 2
        
        user_permissions = request.session.get('permissions', {})
        user_level = user_permissions.get(category, 0)
        
        return user_level >= required_level


