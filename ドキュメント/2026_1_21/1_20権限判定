router.beforeEach((to, from, next) => {
  const authStore = useAuthStore()
  
  // 権限チェックが必要か
  if (to.meta.permission) {
    const { category, level } = to.meta.permission
    const userLevel = authStore.permissions[category] || 0
    
    if (userLevel < level) {
      // 権限なし
      next('/forbidden')
    } else {
      next()
    }
  } else {
    next()
  }
