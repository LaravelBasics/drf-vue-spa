# permissions/permission_classes.py
from rest_framework import permissions

class HasPermission(permissions.BasePermission):
    """
    カスタムパーミッション
    
    使い方:
    class MyViewSet(viewsets.ModelViewSet):
        permission_classes = [HasPermission]
        permission_category = 'A'
        permission_level = 2
    """
    
    def has_permission(self, request, view):
        # ビューから権限設定を取得
        category = getattr(view, 'permission_category', None)
        required_level = getattr(view, 'permission_level', 1)
        
        if not category:
            return True  # 権限設定なしならOK
        
        # セッションから権限取得
        user_permissions = request.session.get('permissions', {})
        user_level = user_permissions.get(category, 0)
        
        # メソッドによってレベルを変える
        if request.method in ['GET', 'HEAD', 'OPTIONS']:
            required_level = min(required_level, 1)  # 読み取りは1
        else:
            required_level = max(required_level, 2)  # 更新は2
        
        return user_level >= required_level


