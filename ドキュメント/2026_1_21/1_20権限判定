# middleware/permission_middleware.py
class PermissionMiddleware:
    """API全体の基本的な権限チェック"""
    
    def __call__(self, request):
        # /api/customers/* は 'A' 権限必要
        if request.path.startswith('/api/customers'):
            if not self._has_permission(request, 'A', 1):
                return JsonResponse({'error': '権限なし'}, status=403)
        
        # /api/products/* は 'B' 権限必要
        elif request.path.startswith('/api/products'):
            if not self._has_permission(request, 'B', 1):
                return JsonResponse({'error': '権限なし'}, status=403)
        
        return self.get_response(request)


