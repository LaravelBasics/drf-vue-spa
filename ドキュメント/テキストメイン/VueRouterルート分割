## 🚀 新しいモジュールの追加方法

### 例：商品管理（Products）を追加

#### ステップ1: モジュールファイルを作成

```javascript
// src/router/modules/products.js
import { routes } from '@/constants/routes';
import i18n from '@/plugins/i18n';

const { t } = i18n.global;

export default {
    path: 'products',  // /admin/products
    meta: {
        breadcrumb: 'breadcrumbs.products.list',
    },
    children: [
        {
            path: '',
            name: 'ProductList',
            component: () => import('@/views/products/ProductList.vue'),
            meta: {
                title: t('pages.products.list.title'),
            },
        },
        {
            path: 'create',
            name: 'ProductCreate',
            component: () => import('@/views/products/ProductCreate.vue'),
            meta: {
                breadcrumb: 'breadcrumbs.products.create',
                title: t('pages.products.create.title'),
            },
        },
        {
            path: ':id',
            component: () => import('@/views/products/ProductWrapper.vue'),
            meta: {
                breadcrumb: 'breadcrumbs.products.detail',
            },
            children: [
                {
                    path: '',
                    name: 'ProductDetail',
                    component: () => import('@/views/products/ProductDetail.vue'),
                    meta: {
                        breadcrumb: false,
                        title: t('pages.products.detail.title'),
                    },
                    props: true,
                },
                {
                    path: 'update',
                    name: 'ProductUpdate',
                    component: () => import('@/views/products/ProductUpdate.vue'),
                    meta: {
                        breadcrumb: 'breadcrumbs.products.update',
                        title: t('pages.products.update.title'),
                    },
                    props: true,
                },
            ],
        },
    ],
};
```

#### ステップ2: メインルーターにインポート

```javascript
// src/router/index.js
import productsRoutes from './modules/products.js';  // ← 追加

const router = createRouter({
    routes: [
        // ...
        {
            path: routes.ADMIN.ROOT,
            children: [
                adminRoutes,
                usersRoutes,
                productsRoutes,  // ← 追加
            ],
        },
    ],
});
```

#### ステップ3: 定数を追加

```javascript
// src/constants/routes.js
export const routes = Object.freeze({
    ADMIN: {
        // ...
        PRODUCTS: {
            SEGMENT: 'products',
            INDEX: '',
            CREATE: 'create',
            DETAIL: ':id',
            UPDATE: 'update',
        },
    },
});

export const ROUTE_NAMES = Object.freeze({
    ADMIN: {
        // ...
        PRODUCTS: {
            LIST: 'ProductList',
            CREATE: 'ProductCreate',
            DETAIL: 'ProductDetail',
            UPDATE: 'ProductUpdate',
        },
    },
});
```

これだけ！3ステップで新しいモジュールを追加完了！✨

