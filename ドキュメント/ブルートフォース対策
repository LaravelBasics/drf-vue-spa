accounts/signals.py（新規作成）
python"""
認証イベント監査シグナル

責務:
- ログイン成功/失敗
- アカウントロックアウト
- ログアウト（必要なら）
"""

import logging
from django.dispatch import receiver
from django.contrib.auth.signals import user_logged_in, user_login_failed
from axes.signals import user_locked_out
from common.context import get_client_ip

audit_logger = logging.getLogger("audit")


@receiver(user_locked_out)
def log_axes_lockout(sender, request, username, ip_address, **kwargs):
    """
    Axesによるアカウントロック時の監査ログ
    
    Args:
        username: カスタムusername（group_id:user_id形式）
        ip_address: IPアドレス
    """
    # group_id:user_id を分解
    parts = username.split(':', 1) if ':' in username else [None, username]
    group_id = parts[0] if len(parts) == 2 else None
    user_id = parts[1] if len(parts) == 2 else parts[0]
    
    audit_logger.error(
        f"アカウントロック: user_id={user_id}, group_id={group_id}",
        extra={
            "action": "ACCOUNT_LOCKED",
            "user": user_id,
            "group_id": group_id,
            "ip": ip_address,
            "request_id": getattr(request, "_request_id", "N/A"),
            "model": "Auth",
            "object_id": None,
            "changes": "{}",
        },
    )


@receiver(user_login_failed)
def log_login_failed(sender, request, credentials, **kwargs):
    """ログイン失敗の監査ログ"""
    username = credentials.get('username', 'unknown')
    
    audit_logger.warning(
        f"ログイン失敗: username={username}",
        extra={
            "action": "LOGIN_FAILED",
            "user": username,
            "ip": get_client_ip(request),
            "request_id": getattr(request, "_request_id", "N/A"),
            "model": "Auth",
            "object_id": None,
            "changes": "{}",
        },
    )


@receiver(user_logged_in)
def log_login_success(sender, request, user, **kwargs):
    """ログイン成功の監査ログ"""
    audit_logger.info(
        f"ログイン成功: user_id={user.user_id}",
        extra={
            "action": "LOGIN_SUCCESS",
            "user": user.user_id,
            "ip": get_client_ip(request),
            "request_id": getattr(request, "_request_id", "N/A"),
            "model": "Auth",
            "object_id": user.pk,
            "changes": "{}",
        },
    )
