from rest_framework import serializers
from django.utils.translation import gettext_lazy as _
from django.contrib.auth import get_user_model
from users.models import UserGroup, GroupAuthority, Group
import re
import logging

User = get_user_model()
logger = logging.getLogger(__name__)


class UserSerializer(serializers.ModelSerializer):
    """
    ユーザー情報（ログイン・認証用）

    current_group: セッションから取得（整合性チェック付き）
    group_authorities: 現在のグループの権限
    """

    current_group = serializers.SerializerMethodField()
    group_authorities = serializers.SerializerMethodField()

    class Meta:
        model = User
        fields = [
            "user_id",
            "username",
            "is_admin",
            "is_active",
            "current_group",
            "group_authorities",
        ]
        read_only_fields = fields

    def get_current_group(self, obj):
        """
        セッションから現在のグループ情報を取得
        
        不正なセッション情報（所属していないグループ）は自動削除
        """
        request = self.context.get("request")

        if not request or not hasattr(request, "session"):
            return None

        group_id = request.session.get("current_group_id")

        if not group_id:
            return None

        try:
            # ユーザーグループ所属チェック
            user_group = UserGroup.objects.filter(
                user_id=obj.user_id, 
                group_id=group_id, 
                is_active=True
            ).first()

            if not user_group:
                # ✅ 所属していない場合、セッションから削除
                logger.warning(
                    f"User {obj.user_id} not in group {group_id}, clearing session"
                )
                request.session.pop("current_group_id", None)
                request.session.modified = True  # ✅ Django公式推奨
                return None

            # グループ存在・アクティブチェック
            group = Group.objects.filter(
                group_id=group_id, 
                is_active=True
            ).first()

            if not group:
                # ✅ グループが無効な場合、セッションから削除
                logger.warning(
                    f"Group {group_id} inactive or not found, clearing session"
                )
                request.session.pop("current_group_id", None)
                request.session.modified = True
                return None

            return {
                "group_id": group.group_id,
                "group_name": group.group_name,
            }

        except Exception as e:
            logger.error(f"Failed to get current group: {e}", exc_info=True)
            # ✅ エラー時もセッションクリア
            request.session.pop("current_group_id", None)
            request.session.modified = True
            return None

    def get_group_authorities(self, obj):
        """現在のグループの権限情報を取得"""
        request = self.context.get("request")

        if not request or not hasattr(request, "session"):
            return None

        group_id = request.session.get("current_group_id")

        if not group_id:
            return None

        try:
            authority = GroupAuthority.objects.get(group_id=group_id)
            return GroupAuthoritySerializer(authority).data
        except GroupAuthority.DoesNotExist:
            # 権限未設定の場合は全て0
            return {
                f"permission_{i}": GroupAuthority.PERMISSION_NONE 
                for i in range(1, 11)
            }
        except Exception as e:
            logger.error(f"Failed to get group authorities: {e}", exc_info=True)
            return None

