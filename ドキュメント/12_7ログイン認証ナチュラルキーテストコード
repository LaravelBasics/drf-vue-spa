class UserSerializer(serializers.ModelSerializer):
    """
    ユーザー情報（ログイン・認証用）

    current_group: セッションから取得
    group_authorities: 現在のグループの権限
    """

    current_group = serializers.SerializerMethodField()
    group_authorities = serializers.SerializerMethodField()

    class Meta:
        model = User
        fields = [
            "user_id",
            "username",
            "is_admin",
            "is_active",
            "current_group",
            "group_authorities",
        ]
        read_only_fields = fields

    def get_current_group(self, obj):
        """セッションから現在のグループ情報を取得"""
        request = self.context.get("request")

        if not request or not hasattr(request, "session"):
            return None

        group_id = request.session.get("current_group_id")

        if not group_id:
            return None

        try:
            # リレーションなしなので直接クエリ
            user_group = UserGroup.objects.filter(
                user_id=obj.user_id, group_id=group_id, is_active=True
            ).first()

            if not user_group:
                return None

            group = Group.objects.filter(group_id=group_id, is_active=True).first()

            if not group:
                return None

            return {
                "group_id": group.group_id,
                "group_name": group.group_name,
            }
        except Exception:
            return None

    def get_group_authorities(self, obj):
        """現在のグループの権限情報を取得"""
        request = self.context.get("request")

        if not request or not hasattr(request, "session"):
            return None

        group_id = request.session.get("current_group_id")

        if not group_id:
            return None

        try:
            authority = GroupAuthority.objects.get(group_id=group_id)
            return GroupAuthoritySerializer(authority).data
        except GroupAuthority.DoesNotExist:
            # 権限未設定の場合は全て0
            return {f"permission_{i}": GroupAuthority.PERMISSION_NONE for i in range(1, 11)}

