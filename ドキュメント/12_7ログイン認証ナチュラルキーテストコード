            "min_length": _("グループIDは6文字で入力してください"),
            "max_length": _("グループIDは6文字で入力してください"),
        },
    )

    user_id = serializers.CharField(
        max_length=6,
        min_length=6,
        required=True,
        error_messages={
            "required": _("ユーザーIDは必須です"),
            "blank": _("ユーザーIDは必須です"),
            "min_length": _("ユーザーIDは6文字で入力してください"),
            "max_length": _("ユーザーIDは6文字で入力してください"),
        },
    )

    password = serializers.CharField(
        write_only=True,
        required=True,
        min_length=8,
        max_length=128,
        error_messages={
            "required": _("パスワードは必須です"),
            "blank": _("パスワードは必須です"),
            "min_length": _("パスワードは8文字以上で入力してください"),
        },
        style={"input_type": "password"},
    )

    def validate_group_id(self, value):
        """グループID検証"""
        if not value or not value.strip():
            raise serializers.ValidationError(_("グループIDは必須です"))

        if not re.match(r"^[a-zA-Z0-9]+$", value):
            raise serializers.ValidationError(
                _("グループIDは英数字のみで入力してください")
            )

        return value.strip()

    def validate_user_id(self, value):
        """ユーザーID検証"""
        if not value or not value.strip():
            raise serializers.ValidationError(_("ユーザーIDは必須です"))

        if not re.match(r"^[a-zA-Z0-9]+$", value):
            raise serializers.ValidationError(
                _("ユーザーIDは英数字のみで入力してください")
            )

        return value.strip()

    def validate_password(self, value):
        """パスワード検証"""
        if not value:
            raise serializers.ValidationError(_("パスワードは必須です"))

        dangerous_chars = ["'", '"', ";", "--", "/*", "*/", "xp_", "sp_"]
        for char in dangerous_chars:
            if char in value:
                raise serializers.ValidationError(_("使用できない文字が含まれています"))

        return value


