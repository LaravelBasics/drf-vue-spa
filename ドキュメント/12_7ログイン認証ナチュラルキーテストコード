"""
レガシーシステム版モデル定義

特徴:
- マイグレーション不使用（managed = False）
- ナチュラルキー（複合主キー）
- リレーションなし（シンプル）
- DB直でスキーマ作成済み前提
"""

from django.contrib.auth.models import (
    AbstractBaseUser,
    PermissionsMixin,
    BaseUserManager,
)
from django.db import models
from django.utils import timezone


class CustomUserManager(BaseUserManager):
    """カスタムユーザーマネージャー"""

    def create_user(self, user_id, password=None, **extra_fields):
        if not user_id:
            raise ValueError("ユーザーIDは必須です")

        extra_fields.setdefault("is_active", True)
        extra_fields.setdefault("is_admin", False)

        user = self.model(user_id=user_id, **extra_fields)
        user.set_password(password)
        user.save(using=self._db)
        return user


class Group(models.Model):
    """グループマスタ"""

    group_id = models.CharField("グループID", max_length=6, primary_key=True)
    group_name = models.CharField("グループ名", max_length=40)
    is_active = models.BooleanField("アクティブ", default=True)
    created_at = models.DateTimeField("作成日時", default=timezone.now)
    updated_at = models.DateTimeField("更新日時", auto_now=True)

    class Meta:
        db_table = "groups"
        managed = False  # マイグレーション不使用
        verbose_name = "グループ"
        verbose_name_plural = "グループ"

    def __str__(self):
        return f"{self.group_name} ({self.group_id})"


class User(AbstractBaseUser, PermissionsMixin):
    """ユーザーマスタ"""

    user_id = models.CharField("ユーザーID", max_length=6, primary_key=True)
    username = models.CharField("ユーザー名", max_length=20, blank=True, null=True)
    is_admin = models.BooleanField("管理者", default=False)
    is_active = models.BooleanField("アクティブ", default=True)
    created_at = models.DateTimeField("作成日時", default=timezone.now)
    updated_at = models.DateTimeField("更新日時", auto_now=True)

    USERNAME_FIELD = "user_id"
    REQUIRED_FIELDS = []

    objects = CustomUserManager()

    class Meta:
        db_table = "users"
        managed = False  # マイグレーション不使用
        verbose_name = "ユーザー"
        verbose_name_plural = "ユーザー"

    def __str__(self):
        return f"{self.user_id} ({self.username or '名前未設定'})"


class UserGroup(models.Model):
    """
    ユーザーグループ関連（複合主キー: user_id + group_id）
    
    注意: DB側は複合主キーだが、Django側は単一主キーとして扱う
    """

    user_id = models.CharField("ユーザーID", max_length=6, primary_key=True)
    group_id = models.CharField("グループID", max_length=6)
    is_active = models.BooleanField("アクティブ", default=True)
    joined_at = models.DateTimeField("参加日時", default=timezone.now)

    class Meta:
        db_table = "user_groups"
        managed = False  # マイグレーション不使用
        verbose_name = "ユーザーグループ"
        verbose_name_plural = "ユーザーグループ"

    def __str__(self):
        return f"{self.user_id} @ {self.group_id}"

    # リレーションなしなので、必要に応じてプロパティで取得
    @property
    def user(self):
        """ユーザーオブジェクトを取得"""
        try:
            return User.objects.get(user_id=self.user_id)
        except User.DoesNotExist:
            return None

    @property
    def group(self):
        """グループオブジェクトを取得"""
        try:
            return Group.objects.get(group_id=self.group_id)
        except Group.DoesNotExist:
            return None


class GroupAuthority(models.Model):
    """
    グループ権限マスタ
    
    権限レベル:
    - 0: 権限なし
    - 1: 閲覧のみ
    - 2: 全権限
    """

    PERMISSION_NONE = 0
    PERMISSION_READ = 1
    PERMISSION_FULL = 2

    PERMISSION_CHOICES = [
        (PERMISSION_NONE, "権限なし"),
        (PERMISSION_READ, "閲覧のみ"),
        (PERMISSION_FULL, "全権限"),
    ]

    group_id = models.CharField("グループID", max_length=6, primary_key=True)
    permission_1 = models.IntegerField("権限1", choices=PERMISSION_CHOICES, default=0)
    permission_2 = models.IntegerField("権限2", choices=PERMISSION_CHOICES, default=0)
    permission_3 = models.IntegerField("権限3", choices=PERMISSION_CHOICES, default=0)
    permission_4 = models.IntegerField("権限4", choices=PERMISSION_CHOICES, default=0)
    permission_5 = models.IntegerField("権限5", choices=PERMISSION_CHOICES, default=0)
    permission_6 = models.IntegerField("権限6", choices=PERMISSION_CHOICES, default=0)
    permission_7 = models.IntegerField("権限7", choices=PERMISSION_CHOICES, default=0)
    permission_8 = models.IntegerField("権限8", choices=PERMISSION_CHOICES, default=0)
    permission_9 = models.IntegerField("権限9", choices=PERMISSION_CHOICES, default=0)
    permission_10 = models.IntegerField("権限10", choices=PERMISSION_CHOICES, default=0)
    created_at = models.DateTimeField("作成日時", default=timezone.now)
    updated_at = models.DateTimeField("更新日時", auto_now=True)

    class Meta:
        db_table = "group_authorities"
        managed = False  # マイグレーション不使用
        verbose_name = "グループ権限"
        verbose_name_plural = "グループ権限"

    def __str__(self):
        return f"権限: {self.group_id}"

    @property
    def group(self):
        """グループオブジェクトを取得"""
        try:
            return Group.objects.get(group_id=self.group_id)
        except Group.DoesNotExist:
            return None

    def get_permission(self, permission_num):
        """指定された権限番号の値を取得"""
        if 1 <= permission_num <= 10:
            return getattr(self, f"permission_{permission_num}")
        raise ValueError("権限番号は1-10の範囲で指定してください")

    def has_read_permission(self, permission_num):
        """閲覧権限があるか"""
        return self.get_permission(permission_num) >= self.PERMISSION_READ

    def has_full_permission(self, permission_num):
        """全権限があるか"""
        return self.get_permission(permission_num) >= self.PERMISSION_FULL

