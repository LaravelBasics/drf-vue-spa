### **Serializer実装**

```python
# accounts/serializers.py
from rest_framework import serializers
from common.models import MUser

class UserSerializer(serializers.ModelSerializer):
    """
    ユーザー情報シリアライザー
    """
    
    # ① display_name を SerializerMethodField で定義
    display_name = serializers.SerializerMethodField()
    
    # ② 既存のフィールドも SerializerMethodField
    current_group = serializers.SerializerMethodField()
    is_admin = serializers.SerializerMethodField()
    
    class Meta:
        model = MUser
        fields = [
            'user_id',
            'first_name',
            'last_name',
            'display_name',  # ③ Meta.fields に追加
            'email',
            'is_active',
            'is_admin',
            'current_group',
        ]
        read_only_fields = fields
    
    # ④ get_display_name メソッド
    def get_display_name(self, obj):
        """
        姓名を結合してフルネームを返す
        
        Args:
            obj: MUser モデルインスタンス
        
        Returns:
            str: "山田 太郎"
        """
        if obj.last_name and obj.first_name:
            return f"{obj.last_name} {obj.first_name}"
        elif obj.last_name:
            return obj.last_name
        elif obj.first_name:
            return obj.first_name
        else:
            return obj.user_id  # フォールバック
    
    def get_is_admin(self, obj):
        """管理者権限チェック"""
        return bool(obj.is_superuser or obj.is_staff)
    
    def get_current_group(self, obj):
        """セッションから現在のグループ情報を取得"""
        request = self.context.get('request')
        if not request:
            return None
        
        group_id = request.session.get('current_group_id')
        if not group_id:
            return None
        
        # グループ情報を取得して返す
        # ...（既存のコード）
```

