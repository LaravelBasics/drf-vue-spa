## <a name="practical-examples"></a>💼 7. 実践例

### 例1: 基本的な使い方

```python
# ユーザー一覧取得（グループ名も表示）
users = MUser.objects.select_related('group').all()

for user in users:
    print(f"{user.username} ({user.group.group_name})")

# 出力:
# 山田太郎 (営業部)
# 佐藤花子 (開発部)
# 鈴木一郎 (営業部)
```

### 例2: 複数のForeignKey

```python
# models.py
class MUser(models.Model):
    group = models.ForeignKey(MGroup, ...)
    manager = models.ForeignKey(MManager, ...)  # 2つ目

# views.py
users = MUser.objects.select_related('group', 'manager').all()
#                                    ↑       ↑
#                                    複数指定可能

for user in users:
    print(user.username, user.group.group_name, user.manager.manager_name)
```

### 例3: ネストしたリレーション

```python
# models.py
class MCompany(models.Model):
    company_code = models.CharField(primary_key=True)
    company_name = models.CharField(max_length=100)

class MGroup(models.Model):
    group_code = models.CharField(primary_key=True)
    company = models.ForeignKey(MCompany, ...)

class MUser(models.Model):
    group = models.ForeignKey(MGroup, ...)

# views.py
# ユーザー → グループ → 会社 を一度に取得
users = MUser.objects.select_related('group__company').all()
#                                    ↑ ダブルアンダースコアで辿る

for user in users:
    print(user.username, 
          user.group.group_name, 
          user.group.company.company_name)
```

### 例4: フィルタと組み合わせ

```python
# 営業部のアクティブなユーザーを取得
users = MUser.objects.select_related('group').filter(
    group__group_code='G001',
    is_active=True
)
```

### 例5: DRF（シリアライザー）

```python
# serializers.py
class GroupSerializer(serializers.ModelSerializer):
    class Meta:
        model = MGroup
        fields = ['group_code', 'group_name']

class UserSerializer(serializers.ModelSerializer):
    group = GroupSerializer()  # ネストしたシリアライザー
    
    class Meta:
        model = MUser
        fields = ['user_id', 'username', 'group']

# views.py
class UserViewSet(viewsets.ModelViewSet):
    # ★select_relatedを忘れずに！★
    queryset = MUser.objects.select_related('group')
    serializer_class = UserSerializer
```

