## 🎯 **パフォーマンス比較**

### **ベンチマーク例**

```python
import time
from django.db import connection

# ❌ N+1問題
def bad_query():
    start = time.time()
    users = MUser.objects.all()
    for user in users:
        print(user.group.group_name)
    print(f"Time: {time.time() - start:.2f}s")
    print(f"Queries: {len(connection.queries)}")

# 結果:
# Time: 5.23s
# Queries: 101

# ✅ select_related
def good_query():
    start = time.time()
    users = MUser.objects.select_related('group').all()
    for user in users:
        print(user.group.group_name)
    print(f"Time: {time.time() - start:.2f}s")
    print(f"Queries: {len(connection.queries)}")

# 結果:
# Time: 0.05s
# Queries: 1

# パフォーマンス改善: 100倍以上！
```

