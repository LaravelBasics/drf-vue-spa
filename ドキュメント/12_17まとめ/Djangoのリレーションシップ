```

```python
# serializers.py
class GroupSerializer(serializers.ModelSerializer):
    member_count = serializers.SerializerMethodField()
    
    def get_member_count(self, obj):
        # prefetch_related済みなので、SQLなし
        return obj.user_set.count()
```

