user_input = "admin' OR '1'='1"
User.objects.filter(username=user_input)
# → WHERE username = 'admin\' OR \'1\'=\'1'
# ちゃんとエスケープされる

# ✅ Q objects：自動でエスケープ
User.objects.filter(
    Q(username=user_input) | Q(email=user_input)
)
