## 📊 2. テストデータの作成

### 方法1: Django管理コマンド（推奨）

`users/management/commands/create_test_data.py` を作成：

```python
from django.core.management.base import BaseCommand
from users.models import User, Group, UserGroup


class Command(BaseCommand):
    help = "グループ認証用のテストデータを作成"

    def handle(self, *args, **options):
        # グループ作成
        groups_data = [
            ("group_a", "グループA"),
            ("group_b", "グループB"),
            ("group_c", "グループC"),
        ]

        for group_id, group_name in groups_data:
            group, created = Group.objects.get_or_create(
                group_id=group_id, defaults={"group_name": group_name}
            )
            if created:
                self.stdout.write(
                    self.style.SUCCESS(f"✓ グループ作成: {group_name}")
                )

        # ユーザー作成
        users_data = [
            ("user001", "テストユーザー1", "password123", ["group_a"]),
            ("user002", "テストユーザー2", "password123", ["group_a", "group_b"]),
            ("user003", "テストユーザー3", "password123", ["group_c"]),
            ("admin001", "管理者", "admin123", ["group_a", "group_b", "group_c"]),
        ]

        for user_id, username, password, group_ids in users_data:
            user, created = User.objects.get_or_create(
                user_id=user_id,
                defaults={"username": username, "is_admin": user_id.startswith("admin")},
            )

            if created:
                user.set_password(password)
                user.save()
                self.stdout.write(
                    self.style.SUCCESS(f"✓ ユーザー作成: {username} ({user_id})")
                )

            # グループ割り当て
            for group_id in group_ids:
                group = Group.objects.get(group_id=group_id)
                UserGroup.objects.get_or_create(user=user, group=group)
                self.stdout.write(f"  - {group.group_name} に追加")

        self.stdout.write(
            self.style.SUCCESS("\n🎉 テストデータの作成が完了しました！")
        )
```

