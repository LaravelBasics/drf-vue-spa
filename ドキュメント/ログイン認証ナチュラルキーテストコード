pythondef authenticate(self, request, username=None, password=None, group_id=None):
    user_id = username
    
    # 1️⃣ usersテーブルを見に行く
    user = User.objects.filter(user_id=user_id).first()
    
    if user is None:
        return None  # ユーザー不在
    
    # 2️⃣ パスワード検証
    if not user.check_password(password):
        return None  # パスワード不一致
    
    # 3️⃣ user_groupsテーブルを見に行く（グループ所属チェック）
    if not user.groups_rel.filter(group_id=group_id, is_active=True).exists():
        return None  # このグループに所属していない
    
    # ✅ すべてOKならログイン成功
    return user
