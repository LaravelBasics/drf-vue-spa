# ===== 1. context.py に group_id 取得関数を追加 =====

# common/context.py (既存のファイルに追記)

def get_current_group_id(request=None):
    """
    現在のグループIDを取得
    
    Args:
        request: Django HTTPRequest オブジェクト (オプション)
    
    Returns:
        str: グループID or None
    """
    if request is None:
        request = get_current_request()
    
    if not request:
        return None
    
    # セッションから取得
    group_id = request.session.get('current_group_id')
    if group_id:
        return group_id
    
    # ユーザーオブジェクトから取得（もし保存されている場合）
    if hasattr(request, 'user') and request.user.is_authenticated:
        if hasattr(request.user, 'group_id'):
            return request.user.group_id
    
    return None


