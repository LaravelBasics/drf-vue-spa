SESSION_COOKIE_SAMESITE = "Lax"
# CSRF対策
# Lax: 通常のナビゲーションでCookie送信、クロスサイトPOSTでは送信しない
# Strict: 同一サイトのみCookie送信
# None: 常にCookie送信（Secure=Trueが必要）
