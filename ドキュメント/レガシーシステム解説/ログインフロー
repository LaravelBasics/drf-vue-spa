async function onSubmit() {
    if (loading.value) return;  // 二重送信防止
    
    // 1. フロント側バリデーション
    const { valid } = await form.value.validate();
    if (!valid) return;
    
    loading.value = true;
    
    try {
        // 2. authStore.loginSession() 実行
        await auth.loginSession(groupId.value, userId.value, password.value);
        
        // 3. ログイン成功
        showInfo('auth.loginSuccess', {}, 3000);
        isVisible.value = false;
        
        // 4. ホーム画面へ遷移
        setTimeout(async () => {
            const redirect = route.query.next || ROUTE_NAMES.HOME;
            await router.push(redirect);
        }, 150);
        
    } catch (error) {
        // 5. エラーハンドリング
        handleApiError(error);
    } finally {
        loading.value = false;
    }
}
