### ステップ2: authStore.initialize()

**ファイル**: `frontend/src/stores/auth.js`

```javascript
async function initialize() {
    // 既に初期化済みなら何もしない
    if (initialized.value) {
        return;
    }

    loading.value = true;

    try {
        // user.value が存在するか確認
        if (user.value) {
            // ★localStorage復元後★
            // セッションの有効性を確認するため、ユーザー情報を再取得
            try {
                await fetchUser();
            } catch (error) {
                if (error.response?.status === 403) {
                    // セッション無効
                    user.value = null;
                    error.value = null;
                    currentGroupId.value = null;
                    currentGroupName.value = null;
                }
            }
        }
    } finally {
        initialized.value = true;
        loading.value = false;
    }
}
```

