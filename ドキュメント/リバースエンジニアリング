python# views.py（デバッグ用ビュー追加）
from django.http import JsonResponse
from django.views import View

class SessionDebugView(View):
    """セッション確認用（開発環境のみ）"""
    
    def get(self, request):
        return JsonResponse({
            # セッション情報
            'session_key': request.session.session_key,
            'session_data': dict(request.session),
            
            # 認証情報
            'is_authenticated': request.user.is_authenticated,
            'user_id': getattr(request.user, 'legacy_user_id', None) if request.user.is_authenticated else None,
            
            # Cookie情報
            'cookies': {
                'sessionid': request.COOKIES.get('sessionid'),
                'csrftoken': request.COOKIES.get('csrftoken'),
            },
            
            # セッション設定
            'settings': {
                'SESSION_COOKIE_AGE': request.session.get_expiry_age(),
                'SESSION_COOKIE_HTTPONLY': True,  # settings.pyの値
            }
        })

# urls.py
urlpatterns = [
    path('api/debug/session/', SessionDebugView.as_view()),
]
