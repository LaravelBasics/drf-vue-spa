# authentication.py
from django.contrib.auth.backends import BaseBackend
from django.contrib.auth.models import User
from .models import LegacyUser, LegacyUserGroup
import hashlib

class QuickAuthBackend(BaseBackend):
    """とりあえず動く認証"""
    def authenticate(self, request, username=None, password=None, group_id=None, **kwargs):
        try:
            user = LegacyUser.objects.get(user_id=username)
            # パスワードチェック（レガシーシステムのハッシュ方式）
            if hashlib.sha256(password.encode()).hexdigest() == user.password_hash:
                # グループチェック
                if LegacyUserGroup.objects.filter(user_id=username, group_id=group_id).exists():
                    # Djangoユーザー返す（セッション用）
                    django_user, _ = User.objects.get_or_create(
                        username=f"{username}_{group_id}",
                        defaults={'email': user.email}
                    )
                    django_user.legacy_user_id = username
                    django_user.legacy_group_id = group_id
                    return django_user
        except:
            pass
        return None

# views.py - 最小ログインAPI
import json
from django.contrib.auth import authenticate, login, logout
from django.http import JsonResponse
from django.views import View
from django.views.decorators.csrf import csrf_exempt
from django.utils.decorators import method_decorator

@method_decorator(csrf_exempt, name='dispatch')
class LoginAPI(View):
    def post(self, request):
        data = json.loads(request.body)
        user = authenticate(
            request,
            username=data.get('user_id'),
            password=data.get('password'),
            group_id=data.get('group_id')
        )
        if user:
            login(request, user)
            return JsonResponse({'status': 'ok'})
        return JsonResponse({'status': 'error'}, status=401)

@method_decorator(csrf_exempt, name='dispatch')
class LogoutAPI(View):
    def post(self, request):
        logout(request)
        return JsonResponse({'status': 'ok'})

# urls.py
