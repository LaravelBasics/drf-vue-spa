"""
レガシーシステム対応 認証用シリアライザー

特徴:
- ForeignKey不使用（手動JOIN）
- 文字列主キー対応
- グループ情報を手動で取得
"""

from rest_framework import serializers
from django.utils.translation import gettext_lazy as _
from django.contrib.auth import get_user_model
from .services import UserGroupService

User = get_user_model()


class LoginSerializer(serializers.Serializer):
    """
    ログイン入力データのバリデーション
    
    検証項目:
    - グループID（必須）
    - ユーザーID（必須）
    - パスワード（必須）
    """
    
    group_id = serializers.CharField(
        max_length=50,
        required=True,
        error_messages={
            'required': _('グループIDは必須です'),
            'blank': _('グループIDは必須です'),
        }
    )
    
    user_id = serializers.CharField(
        max_length=50,
        required=True,
        error_messages={
            'required': _('ユーザーIDは必須です'),
            'blank': _('ユーザーIDは必須です'),
        }
    )
    
    password = serializers.CharField(
        write_only=True,
        required=True,
        error_messages={
            'required': _('パスワードは必須です'),
            'blank': _('パスワードは必須です'),
        },
        style={'input_type': 'password'}
    )
    
    def validate(self, attrs):
        """
        全体バリデーション
        
        空白入力の防止
        """
        group_id = attrs.get('group_id', '').strip()
        user_id = attrs.get('user_id', '').strip()
        password = attrs.get('password', '').strip()
        
        if not group_id or not user_id or not password:
            raise serializers.ValidationError(
                _('グループID、ユーザーID、パスワードは必須です')
            )
        
        # トリム後の値を返す
        return {
            'group_id': group_id,
            'user_id': user_id,
            'password': password
        }


class UserSerializer(serializers.ModelSerializer):
    """
    ユーザー情報シリアライザー（ログイン・認証用）
    
    特徴:
    - current_group: セッションから現在のグループ情報を取得
    - ForeignKey不使用（手動でグループ情報取得）
    """
    
    current_group = serializers.SerializerMethodField()
    
    class Meta:
        model = User
        fields = [
            'user_id',
            'username',
            'email',
            'is_admin',
            'is_active',
            'current_group',  # セッションから取得
        ]
        read_only_fields = fields
    
    def get_current_group(self, obj):
        """
        セッションから現在のグループ情報を取得
        
        手順:
        1. request.sessionから現在のgroup_idを取得
        2. UserGroupServiceで手動JOIN
        3. グループ情報を返す
        
        Returns:
            dict: {'group_id': str, 'group_name': str} or None
        """
        request = self.context.get('request')
        
        # requestがない、またはsessionがない場合はNone
        if not request or not hasattr(request, 'session'):
            return None
        
        # セッションからグループIDを取得
        group_id = request.session.get('current_group_id')
        
        if not group_id:
            return None
        
        # ★手動JOIN★
        # ForeignKey使えないので、サービスクラスでグループ情報取得
        group_info = UserGroupService.get_user_group_info(
            user_id=obj.user_id,
            group_id=group_id
        )
        
        return group_info


