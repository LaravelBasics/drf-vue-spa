from rest_framework.permissions import IsAuthenticated

def login(request):
    # 1. リクエストから取得（sessionにはまだない）
    user_id = request.data.get('user_id')
    password = request.data.get('password')
    group_id = request.data.get('group_id')
    
    # 2. 認証
    user = authenticate(username=user_id, password=password)
    if not user:
        return Response({'error': '認証失敗'}, 401)
    
    # 3. 所属チェック
    if not UserGroup.objects.filter(user=user, group_id=group_id).exists():
        return Response({'error': '所属していません'}, 403)
    
    # 4. ログイン（これでsession開始）
    login_user(request, user)  # django.contrib.auth.login
    
    # 5. 5174判定
    origin = request.META.get('HTTP_ORIGIN', '')
    response_data = {'token': ...}
    
    if origin == os.getenv('ADMIN_ORIGIN'):
        # 6. DBから権限取得
        permissions_queryset = GroupPermission.objects.filter(group_id=group_id)
        
        # 7. 整形
        permissions_data = []
        for perm in permissions_queryset:
            parts = perm.permission_column.split('_')
            permissions_data.append({
                'category': parts[0],
                'name': parts[1],
                'level': int(parts[2])
            })
        
        # 8. sessionに保存（ここで初めて保存）
        request.session['permissions'] = permissions_data
        request.session['group_id'] = group_id
        
        response_data['permissions'] = permissions_data
    
    return Response(response_data)
