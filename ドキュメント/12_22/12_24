    # permissions.py
from rest_framework.permissions import BasePermission

class HasSessionPermission(BasePermission):
    """
    sessionに保存された権限をチェック
    """
    def has_permission(self, request, view):
        # view に必要な権限情報が定義されてるかチェック
        required_category = getattr(view, 'required_category', None)
        required_name = getattr(view, 'required_name', None)
        required_level = getattr(view, 'required_level', 1)
        
        # 権限不要なら通す
        if not required_category or not required_name:
            return True
        
        # sessionから権限取得
        permissions = request.session.get('permissions', [])
        
        # 権限チェック
        return any(
            p['category'] == required_category and
            p['name'] == required_name and
            p['level'] >= required_level
            for p in permissions
        )

