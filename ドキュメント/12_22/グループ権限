import { ref } from 'vue'
import { defineStore } from 'pinia'

export const useAuthStore = defineStore('auth', () => {
  // ユーザー情報
  const user = ref(null)
  
  // 権限情報（配列）
  const permissions = ref([])
  
  // ログイン関数
  const login = async (credentials) => {
    const response = await api.post('/login/', credentials)
    
    // ユーザー情報保存
    user.value = response.data.user
    
    // 権限情報保存（配列の辞書）
    permissions.value = response.data.permissions
    // [
    //   { category: 'A', name: '○○', level: 2 },
    //   { category: 'B', name: '××', level: 1 },
    // ]
  }
  
  // 権限チェック関数
  const hasPermission = (category, name, requiredLevel = 1) => {
    const perm = permissions.value.find(
      p => p.category === category && p.name === name
    )
    return perm && perm.level >= requiredLevel
  }
  
  // ログアウト
  const logout = () => {
    user.value = null
    permissions.value = []  // 空配列にリセット★**************
  }
  
  return { user, permissions, login, logout, hasPermission }
})
