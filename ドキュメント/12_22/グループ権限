class GroupSerializer(serializers.ModelSerializer):
    """グループ作成/更新用（グループコード/名の重複チェック）"""
    
    class Meta:
        model = Group
        fields = ['id', 'code', 'name', 'description']
    
    def validate_code(self, value):
        """グループコードの重複チェック"""
        query = Group.objects.filter(code=value)
        
        # 更新時は自分を除外
        if self.instance:
            query = query.exclude(id=self.instance.id)
        
        if query.exists():
            raise serializers.ValidationError(
                f"グループコード '{value}' は既に使用されています"
            )
        
        return value
    
    def validate_name(self, value):
        """グループ名の重複チェック"""
        query = Group.objects.filter(name=value)
        
        # 更新時は自分を除外
        if self.instance:
            query = query.exclude(id=self.instance.id)
        
        if query.exists():
            raise serializers.ValidationError(
                f"グループ名 '{value}' は既に使用されています"
            )
        
        return value


