バックエンド (Serializer)
pythonclass PermissionSerializer(serializers.ModelSerializer):
    permissions = serializers.SerializerMethodField()
    
    def get_permissions(self, obj):
        result = []
        # 11個の権限カラムをループ
        for column in [obj.perm_column1, obj.perm_column2, ...]:
            parts = column.split('_')
            result.append({
                'category': parts[0],    # A, B, C
                'name': parts[1],        # ○○
                'level': int(parts[2])   # 0, 1, 2
            })
        return result
フロントエンド (Pinia + Vue)
javascript// Pinia store
const permissions = ref([
  { category: 'A', name: '○○', level: 2 },
  { category: 'B', name: '××', level: 1 },
  // ... 11個
])

// 権限チェック関数
const hasPermission = (category, name, requiredLevel = 1) => {
  const perm = permissions.value.find(
    p => p.category === category && p.name === name
  )
  return perm && perm.level >= requiredLevel
}

// v-ifで使う
<button v-if="hasPermission('A', '○○', 2)">編集</button>

// router guardで使う
router.beforeEach((to) => {
  if (to.meta.requiresPermission) {
    if (!hasPermission('A', '○○', 1)) {
      return { name: 'forbidden' }
    }
  }
})
