class UserService:
    @staticmethod
    @transaction.atomic  # ✅トランザクション管理
    def register_user(user_id, password, groups):
        # 複雑な処理
        # 1. ユーザー作成
        user = User.objects.create_user(
            user_id=user_id,
            password=password
        )
        
        # 2. グループ紐付け
        for group_id in groups:
            MUserGroup.objects.create(
                user=user,
                group_id=group_id
            )
        
        # 3. 初期設定
        UserSettings.objects.create(user=user)
        
        # 4. 通知送信
        send_welcome_email(user)
        
        return user
