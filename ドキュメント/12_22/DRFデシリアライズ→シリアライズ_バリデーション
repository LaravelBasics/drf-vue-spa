DRFの命名規則
pythonclass GroupSerializer(serializers.ModelSerializer):
    
    # validate_<フィールド名> という名前にすると自動で呼ばれる
    def validate_group_name(self, value):  # group_name用
        if len(value) < 3:
            raise serializers.ValidationError("3文字以上")
        return value
    
    def validate_group_id(self, value):  # group_id用
        if not value.startswith('G'):
            raise serializers.ValidationError("Gで始まる必要")
        return value
