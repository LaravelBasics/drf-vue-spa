バックエンド側
python# serializers.py
class GroupPermissionUpdateSerializer(serializers.Serializer):
    permissions = serializers.ListField(
        child=serializers.DictField(),
        min_length=11,
        max_length=11
    )
    
    LEVEL_MAP = {
        0: 'NONE',
        1: 'READ',
        2: 'UPDATE'
    }
    
    def _to_permission_code(self, category, level):
        """
        分離された状態から結合
        category="A", level=0 → "A_NONE_0"
        """
        return f"{category}_{self.LEVEL_MAP[level]}_{level}"
    
    def validate_permissions(self, value):
        for perm in value:
            category = perm['category']  # そのまま取得
            level = perm['level']        # そのまま取得
            
            # 結合して検証
            permission_code = self._to_permission_code(category, level)
            
            # DBに存在するかチェック
            if not PermissionMaster.objects.filter(code=permission_code).exists():
                raise serializers.ValidationError(
                    f"権限 '{permission_code}' が存在しません"
                )
        
        return value
    
    def save_permissions(self, group_id):
        from django.db import transaction
        
        with transaction.atomic():
            GroupPermission.objects.filter(group_id=group_id).delete()
            
            bulk_list = []
            for perm in self.validated_data['permissions']:
                # ここで最終形式に変換
                permission_code = self._to_permission_code(
                    perm['category'], 
                    perm['level']
                )
                
                bulk_list.append(GroupPermission(
                    group_id=group_id,
                    permission_code=permission_code  # "A_NONE_0"
                ))
            
            GroupPermission.objects.bulk_create(bulk_list)
