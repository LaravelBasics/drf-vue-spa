# views.py
from rest_framework import viewsets, status
from rest_framework.decorators import action
from rest_framework.response import Response
from django.shortcuts import get_object_or_404

from .models import Group, GroupPermission, PermissionMaster
from .serializers import (
    GroupSerializer,
    GroupPermissionUpdateSerializer,
    GroupPermissionListSerializer
)


class GroupViewSet(viewsets.ModelViewSet):
    """グループのCRUD"""
    queryset = Group.objects.all()
    serializer_class = GroupSerializer
    
    @action(detail=True, methods=['get', 'put'], url_path='permissions')
    def permissions(self, request, pk=None):
        """
        グループ権限の取得・更新
        
        GET  /api/groups/{id}/permissions/  → 11個の権限取得
        PUT  /api/groups/{id}/permissions/  → 11個の権限更新
        """
        group = self.get_object()
        
        if request.method == 'GET':
            return self._get_permissions(group)
        elif request.method == 'PUT':
            return self._update_permissions(group, request.data)
    
    def _get_permissions(self, group):
        """権限の取得（11個）"""
        # DBから取得
        group_perms = GroupPermission.objects.filter(
            group_id=group.id
        ).order_by('permission_code')
        
        # レスポンス整形
        permissions = []
        for gp in group_perms:
            # "A_NONE_0" → category="A", level=0 に分解
            parts = gp.permission_code.split('_')
            permissions.append({
                'category': parts[0],  # "A"
                'level': int(parts[2])  # 0, 1, 2
            })
        
        return Response({
            'group_id': group.id,
            'group_name': group.name,
            'permissions': permissions
        })
    
    def _update_permissions(self, group, data):
        """権限の更新（11個）"""
        # シリアライザーでバリデーション
        serializer = GroupPermissionUpdateSerializer(data=data)
        serializer.is_valid(raise_exception=True)
        
        # シリアライザーで保存（検証＆変換はここで実施）
        result = serializer.save_permissions(group.id)
        
        return Response({
            'status': 'updated',
            'group_id': result['group_id'],
            'updated_count': result['updated_count']
        }, status=status.HTTP_200_OK)
