python# models.py
class Member(models.Model):
    id = models.AutoField(primary_key=True)
    name = models.CharField(max_length=100)
    email = models.EmailField()
    password = models.CharField(max_length=255)
    phone = models.CharField(max_length=20)
    address = models.TextField()
    created_at = models.DateTimeField()

# serializers.py

# 入力用（Serializer）
class MemberSearchSerializer(serializers.Serializer):
    """検索条件のバリデーション"""
    member_id = serializers.IntegerField(required=True, min_value=1)

# 出力用（ModelSerializer）
class MemberDetailSerializer(serializers.ModelSerializer):
    """レスポンス用"""
    class Meta:
        model = Member
        fields = ['id', 'name', 'email', 'phone', 'created_at']
        # password と address は含めない（セキュリティ）

# views.py
class MemberSearchView(APIView):
    def post(self, request):
        # 入力チェック
        input_serializer = MemberSearchSerializer(data=request.data)
        if not input_serializer.is_valid():
            return Response(input_serializer.errors, status=400)
        
        # DB検索
        member_id = input_serializer.validated_data['member_id']
        member = get_object_or_404(Member, pk=member_id)
        
        # レスポンス返却
        output_serializer = MemberDetailSerializer(member)
        return Response(output_serializer.data)
        #                              ↑ .data でJSON化
