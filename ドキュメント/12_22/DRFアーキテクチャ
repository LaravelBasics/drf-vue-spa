🎯 実際の使い方：
入力用（Serializer）+ 出力用（ModelSerializer）
python# serializers.py

# ✅ 入力バリデーション用（Metaなし）
class MemberSearchSerializer(serializers.Serializer):
    """検索パラメータのバリデーション"""
    member_id = serializers.IntegerField(
        required=True,
        min_value=1
    )

# ✅ レスポンス返却用（Metaあり）
class MemberDetailSerializer(serializers.ModelSerializer):
    """会員情報のレスポンス"""
    class Meta:
        model = Member
        fields = ['id', 'name', 'email', 'created_at']
        # ↑ レスポンスに含めるフィールド
python# views.py
class MemberSearchView(APIView):
    def post(self, request):
        # 1. 入力バリデーション（Serializer）
        serializer = MemberSearchSerializer(data=request.data)
        if not serializer.is_valid():
            return Response(serializer.errors, status=400)
        
        member_id = serializer.validated_data['member_id']
        
        # 2. DB検索
        member = get_object_or_404(Member, pk=member_id)
        
        # 3. レスポンス返却（ModelSerializer）
        return Response(
            MemberDetailSerializer(member).data
            #                              ↑ .data でJSON化
        )
