class MemberSearchSerializer(serializers.Serializer):
    """基本的なデータバリデーションのみ"""
    member_id = serializers.IntegerField(
        required=True,
        min_value=1,
        error_messages={
            'required': '会員IDを入力してください',
            'invalid': '会員IDは数値で入力してください',
            'min_value': '会員IDは1以上を指定してください'
