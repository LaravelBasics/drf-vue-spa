# views.py
class MemberSearchView(APIView):
    """ビジネスロジック＋存在チェック"""
    permission_classes = [IsAuthenticated]
    
    def post(self, request):
        # 1. 基本バリデーション（Serializer）
        serializer = MemberSearchSerializer(data=request.data)
        if not serializer.is_valid():
            return Response(serializer.errors, status=400)
        
        member_id = serializer.validated_data['member_id']
        
        # 2. 存在チェック＋ビジネスロジック（View）
        try:
            member = Member.objects.get(pk=member_id)
        except Member.DoesNotExist:
            return Response(
                {'detail': '該当する会員が見つかりません'},
                status=404
            )
        
        # 3. 権限チェック（必要なら）
        if not request.user.can_view_member(member):
            return Response(
                {'detail': 'この会員情報を閲覧する権限がありません'},
                status=403
            )
        
        # 4. レスポンス
        return Response(MemberDetailSerializer(member).data)
