# middleware.py
import re

# 参照系POSTのパターン
READONLY_POST_PATTERNS = [
    r'/api/.*/search/',
    r'/api/.*/lookup/',
    r'/api/.*/query/',
]

class AuditLogMiddleware:
    def __call__(self, request):
        response = self.get_response(request)
        
        # POST/PUT/PATCH/DELETEのみログ記録
        if request.method in ['POST', 'PUT', 'PATCH', 'DELETE']:
            # 参照系POSTは除外
            is_readonly = any(
                re.match(pattern, request.path)
                for pattern in READONLY_POST_PATTERNS
            )
            
            if not is_readonly:
                self.log_audit(request, response)
        
        return response

# 👍 URLパターン判別（3番）がシンプルで保守しやすい

