国際化（i18n）対応が必要	パターンB（リクエストヘッダー参照）
🎯 実践例（国際化対応版）：
python
# models.py
class Member(models.Model):
    first_name = models.CharField(max_length=50)
    last_name = models.CharField(max_length=50)
    
    @property
    def display_name_ja(self):
        """日本語表示用"""
        return f"{self.last_name} {self.first_name}"
    
    @property
    def display_name_en(self):
        """英語表示用"""
        return f"{self.first_name} {self.last_name}"

# serializers.py
class MemberDetailSerializer(serializers.ModelSerializer):
    display_name = serializers.SerializerMethodField()
    
    class Meta:
        model = Member
        fields = ['id', 'first_name', 'last_name', 'display_name']
    
    def get_display_name(self, obj):
        # Accept-Languageヘッダーから判定
        locale = self.context['request'].headers.get('Accept-Language', 'ja')
        if locale.startswith('en'):
            return obj.display_name_en
        return obj.display_name_ja

# views.py
class MemberSearchView(APIView):
