## 🎊 **推奨実装**

### **Phase 1: 今すぐ実装（10分）**

```python
# accounts/views.py
class LoginAPIView(APIView):
    def post(self, request):
        # ...認証処理...
        
        if user is not None and user.is_active:
            # ★ 既存セッション破棄 ★
            self._terminate_existing_sessions(user)
            
            # ログイン
            LoginAttemptService.reset_attempts(user_id, group_id)
            login(request, user)
            request.session['current_group_id'] = group_id
            
            self._log_success(request, user_id, group_id)
            
            return Response({
                'detail': 'logged_in',
                'user': UserSerializer(user, context={'request': request}).data
            })
    
    def _terminate_existing_sessions(self, user):
        """既存のセッションをすべて破棄"""
        from django.contrib.sessions.models import Session
        from django.utils import timezone
        
        sessions = Session.objects.filter(expire_date__gte=timezone.now())
        terminated_count = 0
        
        for session in sessions:
            data = session.get_decoded()
            if data.get('_auth_user_id') == str(user.user_id):
                session.delete()
                terminated_count += 1
        
        # 監査ログに記録
        if terminated_count > 0:
            audit_logger.info(
                f'{terminated_count}個の既存セッションを終了しました',
                extra={
                    'user': user.user_id,
                    'action': 'TERMINATE_SESSIONS',
                    'terminated_count': terminated_count
                }
            )
```

